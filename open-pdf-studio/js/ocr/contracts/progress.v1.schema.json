{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpdfstudio.org/contracts/ocr/progress.v1.schema.json",
  "title": "Open PDF Studio one-page OCR progress event contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schemaVersion", "eventId", "sequence", "jobId", "requestId",
    "documentId", "documentRevision", "documentGeneration", "pageId", "pageIndex",
    "pageRevision", "sourceRasterId", "recognitionConfigurationHash", "stage",
    "fraction", "error", "timestamp"
  ],
  "properties": {
    "contract": { "const": "open-pdf-studio.ocr.progress" },
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "common.schema.json#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "jobId": { "$ref": "common.schema.json#/$defs/id" },
    "requestId": { "$ref": "common.schema.json#/$defs/id" },
    "documentId": { "$ref": "common.schema.json#/$defs/id" },
    "documentRevision": { "type": "integer", "minimum": 0 },
    "documentGeneration": { "$ref": "common.schema.json#/$defs/id" },
    "pageId": { "$ref": "common.schema.json#/$defs/id" },
    "pageIndex": { "type": "integer", "minimum": 0 },
    "pageRevision": { "type": "integer", "minimum": 0 },
    "sourceRasterId": { "$ref": "common.schema.json#/$defs/id" },
    "recognitionConfigurationHash": { "$ref": "common.schema.json#/$defs/fingerprint" },
    "stage": {
      "enum": [
        "queued", "rasterizing", "preprocessing", "recognizing", "validating",
        "completed", "partial", "unsupported", "failed", "cancelled"
      ]
    },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "message": { "type": "string", "maxLength": 4096 },
    "error": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "$ref": "common.schema.json#/$defs/id" },
            "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "x-maxUtf8Bytes": 65536,
  "x-ocrSemantic": "progress-v1"
}
