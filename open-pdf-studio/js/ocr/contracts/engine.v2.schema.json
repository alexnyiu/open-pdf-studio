{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpdfstudio.org/contracts/ocr/engine.v2.schema.json",
  "title": "Open PDF Studio OCR engine contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schemaVersion", "engineId", "adapterVersion", "provider",
    "model", "modelPack", "runtime", "capabilities"
  ],
  "properties": {
    "contract": { "const": "open-pdf-studio.ocr.engine" },
    "schemaVersion": { "const": 2 },
    "engineId": { "$ref": "common.schema.json#/$defs/id" },
    "adapterVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "tier", "detection", "recognition"],
      "properties": {
        "family": { "type": "string", "minLength": 1, "maxLength": 256 },
        "tier": { "type": "string", "minLength": 1, "maxLength": 256 },
        "detection": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recognition": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "modelPack": { "$ref": "common.schema.json#/$defs/modelPackIdentity" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executionProvider", "offline"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "executionProvider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "offline": { "const": true }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textDetection", "textRecognition", "lineResults", "linePolygons",
        "lineBaselines", "wordResults", "wordPolygons", "alternatives",
        "languageDetection", "writingDirectionDetection", "preprocessingMetadata",
        "nativePdfWriting"
      ],
      "properties": {
        "textDetection": { "type": "boolean" },
        "textRecognition": { "type": "boolean" },
        "lineResults": { "type": "boolean" },
        "linePolygons": { "type": "boolean" },
        "lineBaselines": { "type": "boolean" },
        "wordResults": { "type": "boolean" },
        "wordPolygons": { "type": "boolean" },
        "alternatives": { "type": "boolean" },
        "languageDetection": { "type": "boolean" },
        "writingDirectionDetection": { "type": "boolean" },
        "preprocessingMetadata": { "type": "boolean" },
        "nativePdfWriting": { "type": "boolean" }
      }
    }
  },
  "x-maxUtf8Bytes": 262144,
  "x-ocrSemantic": "engine-v2"
}
