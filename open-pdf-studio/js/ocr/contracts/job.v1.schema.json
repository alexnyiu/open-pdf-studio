{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpdfstudio.org/contracts/ocr/job.v1.schema.json",
  "title": "Open PDF Studio immutable one-page OCR job contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schemaVersion", "jobId", "requestId", "engineId", "modelPack",
    "document", "page", "recognitionConfigurationHash", "recognitionOptions",
    "documentPolicy", "scheduler", "createdAt"
  ],
  "properties": {
    "contract": { "const": "open-pdf-studio.ocr.job" },
    "schemaVersion": { "const": 1 },
    "jobId": { "$ref": "common.schema.json#/$defs/id" },
    "requestId": { "$ref": "common.schema.json#/$defs/id" },
    "engineId": { "$ref": "common.schema.json#/$defs/id" },
    "modelPack": { "$ref": "common.schema.json#/$defs/modelPackIdentity" },
    "document": { "$ref": "common.schema.json#/$defs/documentIdentity" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "revision", "sourceRaster"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "index": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "sourceRaster": { "$ref": "#/$defs/sourceRaster" }
      }
    },
    "recognitionConfigurationHash": { "$ref": "common.schema.json#/$defs/fingerprint" },
    "recognitionOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languagePolicy", "includeWords", "orientation", "deskew", "preprocessing",
        "rasterDpi", "maximumPixels", "maximumSide", "timeoutMs"
      ],
      "properties": {
        "languagePolicy": { "$ref": "#/$defs/languagePolicy" },
        "includeWords": { "type": "boolean" },
        "orientation": { "$ref": "#/$defs/orientation" },
        "deskew": { "type": "boolean" },
        "preprocessing": { "$ref": "#/$defs/preprocessing" },
        "rasterDpi": { "type": "number", "exclusiveMinimum": 0 },
        "maximumPixels": { "type": "integer", "minimum": 1 },
        "maximumSide": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "documentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skipMeaningfulExistingText", "forceRerun", "replaceApplicationOwnedOcrOnly", "keepCompletedPages"
      ],
      "properties": {
        "skipMeaningfulExistingText": { "type": "boolean" },
        "forceRerun": { "type": "boolean" },
        "replaceApplicationOwnedOcrOnly": { "type": "boolean" },
        "keepCompletedPages": { "type": "boolean" }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "execution"],
      "properties": {
        "priority": { "enum": ["background", "normal", "interactive"] },
        "execution": { "const": "one-page-child" }
      }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "sourceRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "coordinateSpace", "widthPx", "heightPx", "dpi"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "coordinateSpace": { "const": "source-raster-pixels" },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "dpi": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "languagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "languages", "scripts"],
      "properties": {
        "mode": { "enum": ["automatic", "prefer", "restrict"] },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?!und$)(?:[A-Za-z]{2,8})(?:-[A-Za-z0-9]{1,8})*$"
          }
        },
        "scripts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/script" }
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "degrees"],
      "properties": {
        "mode": { "enum": ["none", "detect", "fixed"] },
        "degrees": { "enum": [0, 90, 180, 270, null] }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operations"],
      "properties": {
        "mode": { "enum": ["none", "standard", "custom"] },
        "operations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "enum": ["denoise", "contrast", "binarize", "grayscale"] }
        }
      }
    }
  },
  "x-maxUtf8Bytes": 4194304,
  "x-ocrSemantic": "job-v1"
}
