{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpdfstudio.org/contracts/ocr/model-pack.v1.schema.json",
  "title": "Open PDF Studio macOS OCR model-pack contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schemaVersion", "packId", "packVersion", "platform",
    "engineCompatibility", "modelFamily", "modelTier", "characterCount",
    "recognitionSupport", "distribution", "trust", "applicationCompatibility",
    "license", "upstream", "assets"
  ],
  "properties": {
    "contract": { "const": "open-pdf-studio.ocr.model-pack" },
    "schemaVersion": { "const": 1 },
    "packId": { "$ref": "common.schema.json#/$defs/id" },
    "packVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architectures"],
      "properties": {
        "os": { "const": "macos" },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["arm64", "x86_64"] }
        }
      }
    },
    "engineCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "adapterVersion", "runtime", "models"],
      "properties": {
        "engineId": { "$ref": "common.schema.json#/$defs/id" },
        "adapterVersion": { "$ref": "common.schema.json#/$defs/semver" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "executionProvider"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "executionProvider": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detection", "recognition"],
          "properties": {
            "detection": { "type": "string", "minLength": 1, "maxLength": 256 },
            "recognition": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "modelFamily": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modelTier": { "type": "string", "minLength": 1, "maxLength": 64 },
    "characterCount": { "type": "integer", "minimum": 1 },
    "recognitionSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionMode", "languageSelector", "languages", "scripts"],
      "properties": {
        "selectionMode": { "const": "fixed-multilingual" },
        "languageSelector": { "const": "none" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/languageTag" }
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/script" }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "downloadable"],
      "properties": {
        "bundled": { "type": "boolean" },
        "downloadable": { "type": "boolean" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity", "trustRootId"],
      "properties": {
        "integrity": { "const": "sha256" },
        "trustRootId": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "applicationCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "maximumVersionExclusive"],
      "properties": {
        "minimumVersion": { "$ref": "common.schema.json#/$defs/semver" },
        "maximumVersionExclusive": {
          "anyOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/semver" }]
        }
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "recognition"],
      "properties": {
        "detection": { "$ref": "#/$defs/upstreamComponent" },
        "recognition": { "$ref": "#/$defs/upstreamComponent" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "recognition", "dictionary"],
      "properties": {
        "detection": { "$ref": "#/$defs/asset" },
        "recognition": { "$ref": "#/$defs/asset" },
        "dictionary": { "$ref": "#/$defs/asset" }
      }
    }
  },
  "$defs": {
    "upstreamComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "url"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._/-]+$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "x-maxUtf8Bytes": 1048576,
  "x-ocrSemantic": "model-pack-v1"
}
