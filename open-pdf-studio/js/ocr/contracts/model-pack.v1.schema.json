{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpdfstudio.org/contracts/ocr/model-pack.v1.schema.json",
  "title": "Open PDF Studio macOS OCR model-pack contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "packId",
    "packVersion",
    "platform",
    "engineCompatibility",
    "modelFamily",
    "modelTier",
    "characterCount",
    "languages",
    "license",
    "upstream",
    "assets"
  ],
  "properties": {
    "contract": { "const": "open-pdf-studio.ocr.model-pack" },
    "schemaVersion": { "const": 1 },
    "packId": { "$ref": "#/$defs/id" },
    "packVersion": { "$ref": "#/$defs/semver" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architectures"],
      "properties": {
        "os": { "const": "macos" },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["arm64", "x86_64"] }
        }
      }
    },
    "engineCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "adapterVersion", "runtime", "models"],
      "properties": {
        "engineId": { "$ref": "#/$defs/id" },
        "adapterVersion": { "$ref": "#/$defs/semver" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detection", "recognition"],
          "properties": {
            "detection": { "type": "string", "minLength": 1 },
            "recognition": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "modelFamily": { "type": "string", "minLength": 1 },
    "modelTier": { "type": "string", "minLength": 1 },
    "characterCount": { "type": "integer", "minimum": 1 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/languageTag" }
    },
    "license": { "type": "string", "minLength": 1 },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "recognition"],
      "properties": {
        "detection": { "$ref": "#/$defs/upstreamComponent" },
        "recognition": { "$ref": "#/$defs/upstreamComponent" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "recognition", "dictionary"],
      "properties": {
        "detection": { "$ref": "#/$defs/asset" },
        "recognition": { "$ref": "#/$defs/asset" },
        "dictionary": { "$ref": "#/$defs/asset" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]{2,8}|und)(?:-[A-Za-z0-9]{1,8})*$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executionProvider"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executionProvider": { "type": "string", "minLength": 1 }
      }
    },
    "upstreamComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "url"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
