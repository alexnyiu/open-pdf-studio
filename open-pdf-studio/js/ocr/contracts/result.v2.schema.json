{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpdfstudio.org/contracts/ocr/result.v2.schema.json",
  "title": "Open PDF Studio immutable OCR result contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schemaVersion", "jobId", "requestId", "engine", "document",
    "page", "recognitionConfigurationHash", "sourceRaster", "text", "lines",
    "detectedLanguages", "warnings", "unsupportedContentReasons", "preprocessing", "metrics"
  ],
  "properties": {
    "contract": { "const": "open-pdf-studio.ocr.result" },
    "schemaVersion": { "const": 2 },
    "jobId": { "$ref": "common.schema.json#/$defs/id" },
    "requestId": { "$ref": "common.schema.json#/$defs/id" },
    "engine": { "$ref": "engine.v2.schema.json" },
    "document": { "$ref": "common.schema.json#/$defs/documentIdentity" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index", "revision", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "index": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["completed", "partial", "unsupported", "failed", "cancelled"] }
      }
    },
    "recognitionConfigurationHash": { "$ref": "common.schema.json#/$defs/fingerprint" },
    "sourceRaster": { "$ref": "#/$defs/sourceRaster" },
    "text": { "type": "string", "maxLength": 4194304 },
    "lines": {
      "type": "array",
      "maxItems": 100000,
      "x-uniqueBy": "id",
      "items": { "$ref": "#/$defs/line" }
    },
    "detectedLanguages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/detectedLanguage" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/warning" }
    },
    "unsupportedContentReasons": {
      "type": "array",
      "maxItems": 256,
      "x-uniqueBy": "id",
      "items": { "$ref": "#/$defs/unsupportedReason" }
    },
    "preprocessing": { "$ref": "#/$defs/preprocessing" },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "sourceRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "coordinateSpace", "widthPx", "heightPx", "dpi"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "coordinateSpace": { "const": "source-raster-pixels" },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "dpi": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "outputRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "coordinateSpace", "widthPx", "heightPx", "dpi"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/fingerprint" },
        "coordinateSpace": { "const": "preprocessed-raster-pixels" },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "dpi": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "confidence"],
      "properties": {
        "text": { "type": "string", "maxLength": 4194304 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "detectedLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "confidence"],
      "properties": {
        "tag": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!und$)(?:[A-Za-z]{2,8})(?:-[A-Za-z0-9]{1,8})*$"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "confidence"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "text": { "type": "string", "maxLength": 4194304 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "polygon": { "$ref": "common.schema.json#/$defs/coordinatePolygon" },
        "boundingBox": { "$ref": "common.schema.json#/$defs/coordinateBox" },
        "alternatives": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/alternative" }
        },
        "detectedLanguage": { "$ref": "#/$defs/detectedLanguage" },
        "detectedWritingDirection": { "enum": ["ltr", "rtl", "ttb", "btt"] }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "confidence", "polygon", "baseline"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "text": { "type": "string", "maxLength": 4194304 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "polygon": { "$ref": "common.schema.json#/$defs/coordinatePolygon" },
        "boundingBox": { "$ref": "common.schema.json#/$defs/coordinateBox" },
        "baseline": { "$ref": "common.schema.json#/$defs/engineBaseline" },
        "words": {
          "type": "array",
          "maxItems": 500000,
          "x-uniqueBy": "id",
          "items": { "$ref": "#/$defs/word" }
        },
        "alternatives": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/alternative" }
        },
        "detectedLanguage": { "$ref": "#/$defs/detectedLanguage" },
        "detectedWritingDirection": { "enum": ["ltr", "rtl", "ttb", "btt"] }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "entityIds"],
      "properties": {
        "code": { "$ref": "common.schema.json#/$defs/id" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4194304 },
        "severity": { "enum": ["info", "warning", "error"] },
        "entityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "unsupportedReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "message"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "code": {
          "enum": [
            "handwriting", "table", "math", "vertical-text", "curved-text",
            "rotated-text", "low-confidence", "unknown-language", "complex-layout", "other"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 4194304 },
        "polygon": { "$ref": "common.schema.json#/$defs/coordinatePolygon" }
      }
    },
    "preprocessingOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "applied", "value", "unit"],
      "properties": {
        "kind": { "enum": ["orientation", "deskew", "denoise", "contrast", "binarize", "resize", "crop"] },
        "applied": { "type": "boolean" },
        "value": { "type": ["number", "string", "null"], "maxLength": 256 },
        "unit": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
      }
    },
    "preprocessingTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSpace", "toSpace", "matrix", "inverseMatrix"],
      "properties": {
        "fromSpace": { "const": "source-raster-pixels" },
        "toSpace": { "const": "preprocessed-raster-pixels" },
        "matrix": {
          "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" }
        },
        "inverseMatrix": {
          "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" }
        }
      },
      "x-ocrAffine": true
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operations", "outputRaster", "transform"],
      "properties": {
        "status": { "enum": ["unknown", "none", "applied"] },
        "operations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/preprocessingOperation" }
        },
        "outputRaster": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/outputRaster" }]
        },
        "transform": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/preprocessingTransform" }]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerStartupMs", "modelStartupMs", "rasterMs", "detectionMs",
        "recognitionMs", "totalOcrMs"
      ],
      "properties": {
        "workerStartupMs": { "type": "number", "minimum": 0 },
        "modelStartupMs": { "type": "number", "minimum": 0 },
        "rasterMs": { "type": "number", "minimum": 0 },
        "detectionMs": { "type": "number", "minimum": 0 },
        "recognitionMs": { "type": "number", "minimum": 0 },
        "totalOcrMs": { "type": "number", "minimum": 0 }
      }
    }
  },
  "x-maxUtf8Bytes": 16777216,
  "x-ocrSemantic": "result-v2"
}
